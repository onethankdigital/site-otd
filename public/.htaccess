# Redirecionamentos 301 legados e de alias (devem vir antes do ErrorDocument e mod_rewrite)
RedirectMatch 301 ^/blog/?$ /insights/
RedirectMatch 301 ^/blog/([a-zA-Z0-9\-]+)/?$ /insights/$1/
RedirectMatch 301 ^/quiz/?$ /diagnostico/
RedirectMatch 301 ^/4-pilares/?$ /pilares/
RedirectMatch 301 ^/nossa-historia/?$ /historia/
RedirectMatch 301 ^/google-meu-negocio/?$ /servicos/google-meu-negocio/
RedirectMatch 301 ^/servicos/criacao-de-site/?$ /servicos/criacao-de-sites/
RedirectMatch 301 ^/desenvolvimento-web-premium/?$ /servicos/criacao-de-sites/
RedirectMatch 301 ^/servicos/seo/?$ /servicos/seo-trafego-organico/
RedirectMatch 301 ^/seo-local/?$ /servicos/seo-trafego-organico/
RedirectMatch 301 ^/servicos/automacao/?$ /servicos/automacao-digital/
RedirectMatch 301 ^/automacoes-inteligentes/?$ /servicos/automacao-digital/
# Artigo de GMN 2026 incorporado ao guia do pilar (out/2026)
RedirectMatch 301 ^/insights/google-meu-negocio-guia-completo-2026/?$ /guia/google-meu-negocio/
# Pastas sem página própria: evitam a listagem "Index of" do Apache
RedirectMatch 301 ^/servicos/?$ /
RedirectMatch 301 ^/insights/categoria/?$ /insights/
RedirectMatch 301 ^/(segmentos|atendimento)/?$ /

# Restos do WordPress antigo (tema de demonstração): 410 avisa o Google que sumiram de vez
RedirectMatch 301 ^/home(-4)?/?$ /
RedirectMatch 410 ^/(wp-admin|wp-content|wp-includes|wp-json|tag|category|portfolio|comments)(/.*)?$
RedirectMatch 410 ^/(.+/)?feed/?$
RedirectMatch 410 ^/(portfolio-grid|portfolio-no-gap|transforming-challenges-into|tackling-the-changes-of-retail-industry|how-to-make-your-ios-13-compatible|how-to-make-website-wcag-compliant|the-future-of-ecommerce-business|free-advertising-for-your-online|you-have-a-great-business-idea-2|design-inspiration-where-to-find|creating-new-working-in-the-digital(-3)?|non-sit-libero-viverra-mollis-non-ligula-tincidunt-congue-porta-attention-simply)/?$
RedirectMatch 410 ^/cgi-sys/suspendedpage\.cgi$

# Nunca listar o conteúdo de pastas (ex.: /assets/)
Options -Indexes

ErrorDocument 404 /404.html

# Enable rewrite engine for SPA routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Versão única do domínio: www.onethank.com.br -> onethank.com.br
  RewriteCond %{HTTP_HOST} ^www\.onethank\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://onethank.com.br/$1 [R=301,L]

  # Apresentação comercial em PDF servida em URL limpa
  RewriteRule ^apresentacao-one-thank-digital/?$ /apresentacao-one-thank-digital.pdf [L]
  RewriteRule ^apresentacao-onehub/?$ /apresentacao-onehub.pdf [L]

  # Serve static files as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Apresentação comercial: abrir no navegador (inline) e não indexar no Google
<IfModule mod_headers.c>
  <FilesMatch "^apresentacao-one-thank-digital\.pdf$">
    Header set Content-Disposition 'inline; filename="Apresentacao-One-Thank-Digital.pdf"'
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "^apresentacao-onehub\.pdf$">
    Header set Content-Disposition 'inline; filename="Apresentacao-OneHub.pdf"'
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
