# Redirecionamentos 301 legados e de alias (devem vir antes do ErrorDocument e mod_rewrite)
RedirectMatch 301 ^/blog/?$ /insights/
RedirectMatch 301 ^/blog/([a-zA-Z0-9\-]+)/?$ /insights/$1/
RedirectMatch 301 ^/quiz/?$ /diagnostico/
RedirectMatch 301 ^/4-pilares/?$ /pilares/
RedirectMatch 301 ^/nossa-historia/?$ /historia/
RedirectMatch 301 ^/google-meu-negocio/?$ /servicos/google-meu-negocio/
RedirectMatch 301 ^/servicos/criacao-de-site/?$ /servicos/criacao-de-sites/
RedirectMatch 301 ^/desenvolvimento-web-premium/?$ /servicos/criacao-de-sites/
RedirectMatch 301 ^/servicos/seo/?$ /servicos/seo-trafego-organico/
RedirectMatch 301 ^/seo-local/?$ /servicos/seo-trafego-organico/
RedirectMatch 301 ^/servicos/automacao/?$ /servicos/automacao-digital/
RedirectMatch 301 ^/automacoes-inteligentes/?$ /servicos/automacao-digital/
# Pastas sem página própria: evitam a listagem "Index of" do Apache
RedirectMatch 301 ^/servicos/?$ /
RedirectMatch 301 ^/insights/categoria/?$ /insights/

# Nunca listar o conteúdo de pastas (ex.: /assets/)
Options -Indexes

ErrorDocument 404 /404.html

# Enable rewrite engine for SPA routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Apresentação comercial em PDF servida em URL limpa
  RewriteRule ^apresentacao-one-thank-digital/?$ /apresentacao-one-thank-digital.pdf [L]
  RewriteRule ^apresentacao-onehub/?$ /apresentacao-onehub.pdf [L]

  # Serve static files as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Apresentação comercial: abrir no navegador (inline) e não indexar no Google
<IfModule mod_headers.c>
  <FilesMatch "^apresentacao-one-thank-digital\.pdf$">
    Header set Content-Disposition 'inline; filename="Apresentacao-One-Thank-Digital.pdf"'
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "^apresentacao-onehub\.pdf$">
    Header set Content-Disposition 'inline; filename="Apresentacao-OneHub.pdf"'
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
